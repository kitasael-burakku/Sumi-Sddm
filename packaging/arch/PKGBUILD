# Sumi SDDM — paquetes locales, construidos desde este repositorio (sin descargas).
#   cd packaging/arch && makepkg              # construir los dos (sin root)
#   sudo pacman -U sumi-sddm-0*.pkg.tar.zst   # el tema, la CLI y el helper: NO activa el tema
#   sudo pacman -U sumi-sddm-editor-*.pkg.tar.zst   # opcional: la ventana «Sumi Settings» (PySide6)
#   El paquete trae la CLI en /usr/bin/sumi-sddm; `install --user` sólo hace falta sin el paquete.
# Dividido para que el tema nunca dependa de PySide6 (docs/EDITOR-PLAN.md, D2).
pkgbase=sumi-sddm
pkgname=('sumi-sddm' 'sumi-sddm-editor')
# Literal (namcap analiza el PKGBUILD sin coreutils); tests/py/test_packaging.py exige que coincida con VERSION.
pkgver=0.6.2
pkgrel=1
pkgdesc="Minimal SDDM login theme with Login Edge, a notch-shaped sign-in panel at the top"
arch=('any')
url="https://github.com/kitasael-burakku/Sumi-Sddm"
# El proyecto es MIT (LICENSE); Inter va con la SIL OFL 1.1.
license=('MIT' 'OFL-1.1')
# pyside6 e hicolor-icon-theme: los usa el subpaquete del editor (namcap los exige en un PKGBUILD dividido);
# check() además prueba su backend con pyside6.
makedepends=('python' 'pyside6' 'hicolor-icon-theme')
source=()

_src() { realpath "$startdir/../.."; }

check() {
  cd "$(_src)"
  python3 -B tools/sumi-sddm gen --check
  [ "$(tr -d '[:space:]' < VERSION)" = "$pkgver" ] || { echo "pkgver ≠ VERSION"; return 1; }
  python3 -B -m unittest discover -s tests/py -p 'test_helper.py'
  python3 -B -m unittest discover -s tests/py -p 'test_packaging.py'
  QT_QPA_PLATFORM=offscreen python3 -B -m unittest discover -s tests/py -p 'test_editor_backend.py'
}

package_sumi-sddm() {
  pkgdesc="Minimal SDDM login theme with Login Edge, a notch-shaped sign-in panel at the top, plus its command-line tool and a polkit helper to apply its settings"
  depends=('sddm' 'qt6-declarative' 'python' 'polkit' 'util-linux' 'systemd')
  optdepends=('qt6-imageformats: WebP wallpapers'
              'sumi-sddm-editor: graphical settings window')
  install=sumi-sddm.install
  local src
  src="$(_src)"
  # El tema. Sin theme.conf.user ni backgrounds/: los pone el helper con la configuración de cada usuario.
  install -d "$pkgdir/usr/share/sddm/themes/sumi"
  cp -r --no-preserve=ownership "$src/theme/sumi/." "$pkgdir/usr/share/sddm/themes/sumi/"
  rm -rf "$pkgdir/usr/share/sddm/themes/sumi/theme.conf.user" "$pkgdir/usr/share/sddm/themes/sumi/backgrounds"
  find "$pkgdir/usr/share/sddm/themes/sumi" -type d -exec chmod 0755 {} + -o -type f -exec chmod 0644 {} +

  # El helper y lo que importa, de root y no escribibles por otros (el helper lo exige al correr como root).
  install -Dm0755 "$src/system/sumi-sddm-helper" "$pkgdir/usr/lib/sumi-sddm/sumi-sddm-helper"
  install -Dm0644 "$src/VERSION" "$pkgdir/usr/lib/sumi-sddm/VERSION"
  install -Dm0644 "$src/schema/config-schema.json" "$pkgdir/usr/lib/sumi-sddm/schema/config-schema.json"
  local f
  for f in "$src"/tools/sumiconf/*.py; do
    install -Dm0644 "$f" "$pkgdir/usr/lib/sumi-sddm/tools/sumiconf/${f##*/}"
  done

  # La CLI sin privilegios (raíz /usr/lib/sumi-sddm: `version` responde kind "system" por el helper de al lado).
  # Su vista previa usa el arnés y el tema instalado; theme/sumi es un enlace relativo a él.
  install -Dm0755 "$src/tools/sumi-sddm" "$pkgdir/usr/lib/sumi-sddm/tools/sumi-sddm"
  for f in "$src"/tools/harness/*.qml; do
    install -Dm0644 "$f" "$pkgdir/usr/lib/sumi-sddm/tools/harness/${f##*/}"
  done
  install -Dm0644 "$src/docs/CONFIG.md" "$pkgdir/usr/lib/sumi-sddm/docs/CONFIG.md"
  install -d "$pkgdir/usr/lib/sumi-sddm/theme"
  ln -s ../../../share/sddm/themes/sumi "$pkgdir/usr/lib/sumi-sddm/theme/sumi"
  install -Dm0755 "$src/packaging/arch/sumi-sddm.sh" "$pkgdir/usr/bin/sumi-sddm"

  install -Dm0644 "$src/system/org.sumi.sddm.helper.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.sumi.sddm.helper.policy"
  install -Dm0644 "$src/theme/sumi/assets/fonts/OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "$src/docs/RECUPERACION.md" "$pkgdir/usr/share/doc/$pkgname/RECUPERACION.md"
  install -Dm0644 "$src/docs/CONFIG.md" "$pkgdir/usr/share/doc/$pkgname/CONFIG.md"
  install -Dm0644 "$src/docs/CLI-JSON.md" "$pkgdir/usr/share/doc/$pkgname/CLI-JSON.md"
}

package_sumi-sddm-editor() {
  pkgdesc="Settings window for the Sumi SDDM login theme"
  license=('MIT')
  # La misma versión: los dos salen de este repositorio (el editor habla con la CLI por el contrato api 1).
  # sumi-sddm: la CLI, que se lanza como proceso (namcap no lo ve); shiboken6: backend.py lo importa.
  depends=("sumi-sddm=${pkgver}-${pkgrel}" 'python' 'pyside6' 'shiboken6' 'qt6-declarative' 'hicolor-icon-theme')
  optdepends=('qt6-svg: window icon outside the desktop launcher')
  local src f
  src="$(_src)"
  install -Dm0755 "$src/editor/sumi-sddm-editor" "$pkgdir/usr/lib/sumi-sddm/editor/sumi-sddm-editor"
  for f in "$src"/editor/sumi_sddm_editor/*.py "$src"/editor/sumi_sddm_editor/*.qml \
           "$src"/editor/sumi_sddm_editor/qmldir; do
    install -Dm0644 "$f" "$pkgdir/usr/lib/sumi-sddm/editor/sumi_sddm_editor/${f##*/}"
  done
  install -Dm0755 "$src/packaging/arch/sumi-sddm-editor.sh" "$pkgdir/usr/bin/sumi-sddm-editor"
  install -Dm0644 "$src/editor/sumi-sddm-editor.desktop" "$pkgdir/usr/share/applications/sumi-sddm-editor.desktop"
  install -Dm0644 "$src/editor/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sumi-sddm-editor.svg"
  install -Dm0644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
