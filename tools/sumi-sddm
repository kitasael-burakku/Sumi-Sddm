#!/usr/bin/env python3
"""sumi-sddm — configuración, vista previa y desarrollo de Sumi SDDM. Nada aquí usa privilegios.

Contrato para otros programas (Settings de Sumi Shell): todas las órdenes aceptan --json; ver docs/CLI-JSON.md.
  version [--json]                  versión, versión del contrato (api) y tipo de instalación

Configuración del usuario (en ~/.config/sumi-sddm/; el tema instalado no se toca):
  config path                       ruta de theme.conf.user
  config schema [--json]            esquema completo (claves, tipos, rangos, etiquetas de UI)
  config show [--json]              valores efectivos (defecto o personalizado)
  config get CLAVE                  un valor efectivo
  config set CLAVE=VALOR …          valida todo y escribe de una vez (atómico); VALOR vacío = quitar
  config unset CLAVE …              vuelve al valor por defecto
  config validate [ARCHIVO] [--json]
  config reset                      guarda una copia (.prev) y vuelve a todos los defectos
  config restore                    recupera la copia .prev
  config fonts [--json]             familias instaladas (las de tu $HOME no las verá el greeter)
  wallpaper set ARCHIVO | clear | info [--json]
  Las escrituras admiten --expect HUELLA (la «stamp» de config show): si algo cambió, no se escribe.

Instalación de usuario (sin privilegios; copia, no enlaza):
  install --user | uninstall --user | install --status   ~/.local/share/sumi-sddm + ~/.local/bin/sumi-sddm

Vista previa:
  preview [--out PNG] [--scenario S] [--size AxH] [--json]   captura offscreen con tu configuración
  try --yes                         abre el greeter real en una VENTANA (--test-mode; toma el teclado)

Desarrollo:
  gen [--check]                     regenera schema.js, theme.conf y docs/CONFIG.md desde el esquema
  lint | test | render | smoke | check   (sólo en el repositorio)
"""
from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

from sumiconf import ConfigError, Schema, strict  # noqa: E402
from sumiconf import gen as gen_mod  # noqa: E402
from sumiconf import image, ini, paths, state  # noqa: E402
from sumiconf import install as install_mod  # noqa: E402

ROOT = paths.ROOT
THEME = paths.THEME
QT_BIN = Path("/usr/lib/qt6/bin")
GREETER = "sddm-greeter-qt6"

SCENARIOS = [
    "compact", "expanded", "typing", "caps", "authenticating", "failed", "info", "sessions",
    "confirm", "manual", "other", "nopass", "single", "many", "nosessions", "secondary",
]
SIZES = ["1920x1080", "1366x768", "2560x1440", "3840x2160", "1080x1920"]
BACKENDS = {
    "software": {},
    "opengl": {"QT_QUICK_BACKEND": "rhi", "QSG_RHI_BACKEND": "opengl"},
}
GL_FAILURE = ("Failed to create RHI", "Failed to create QRhi", "QRhiGles2", "Failed to initialize graphics backend")
HEADER = ("Sumi SDDM — configuración del usuario. Escrito por `sumi-sddm config`;\n"
          "las claves y sus valores están documentados en docs/CONFIG.md.")


def emit(obj, as_json: bool, text: str = "") -> None:
    """Respuesta correcta. En JSON siempre lleva `ok` y `api` (docs/CLI-JSON.md)."""
    if as_json:
        print(json.dumps({"ok": True, "api": state.API, **obj}, ensure_ascii=False, indent=1))
    elif text:
        print(text)


def fail(msg: str, as_json: bool = False, rc: int = 1, code: str = "invalid", **extra) -> int:
    """Error. En JSON: {ok: false, api, code, error, …}; `code` es estable, `error` es texto para personas."""
    if as_json:
        print(json.dumps({"ok": False, "api": state.API, "code": code, "error": msg, **extra}, ensure_ascii=False))
    else:
        print(f"sumi-sddm: {msg}", file=sys.stderr)
    return rc


def fail_exc(exc: ConfigError, as_json: bool) -> int:
    return fail(str(exc), as_json, code=exc.code, **exc.extra)


def qt_tool(name: str) -> str:
    p = QT_BIN / name
    if p.exists():
        return str(p)
    found = shutil.which(name)
    if not found:
        sys.exit(f"sumi-sddm: no encuentro {name}")
    return found


def offscreen_env(backend: str) -> dict:
    env = dict(os.environ)
    env.update({"QT_QPA_PLATFORM": "offscreen", "QT_FORCE_STDERR_LOGGING": "1"})
    env.update(BACKENDS[backend])
    for k in ("QT_SCALE_FACTOR", "QT_SCREEN_SCALE_FACTORS", "QT_AUTO_SCREEN_SCALE_FACTOR", "QT_QUICK_CONTROLS_STYLE"):
        env.pop(k, None)
    return env


# ── Configuración del usuario ────────────────────────────────────────────────────────────
def load_user(schema: Schema, path: Path | None = None) -> dict:
    """Valores personalizados validados (estricto). {} si no hay archivo."""
    path = path or paths.user_conf()
    if not path.exists() and not path.is_symlink():
        return {}
    return ini.validate(schema, ini.parse(ini.read_file(path)))


def save_user(schema: Schema, values: dict) -> None:
    ini.write_atomic(paths.user_conf(), ini.render(schema, values, HEADER))


def raw_for_qml(schema: Schema, values: dict) -> dict:
    """Valores tal como los entregaría QSettings al tema (cadenas sin comillas)."""
    return ini.parse(ini.render(schema, values))


def check_background(schema: Schema, value: str) -> None:
    """Además del formato, la imagen referida debe existir y ser válida."""
    if value == "":
        return
    if value.startswith("backgrounds/"):
        f = paths.config_dir() / value
    else:
        f = Path(value)
    image.inspect(f)


def font_warning(schema: Schema, user: dict) -> list[dict]:
    """Aviso si fontFamily no está instalada fuera de $HOME (el greeter no la verá y Qt usará otra)."""
    fam = user.get("fontFamily", "")
    if not fam:
        return []
    try:
        known = {f["family"]: f["system"] for f in state.fonts(re.compile(schema.keys["fontFamily"]["pattern"]))}
    except (ConfigError, OSError, subprocess.SubprocessError):
        return []
    if known.get(fam):
        return []
    why = "only installed in your home folder" if fam in known else "not installed"
    return [{"key": "fontFamily", "message": f"“{fam}” is {why}: the login screen will use another font"}]


def cmd_version(args) -> int:
    out = {"version": state.version(), "schema": Schema.load().version, "kind": state.kind()}
    emit(out, args.json, f"sumi-sddm {out['version']} (api {state.API}, esquema {out['schema']}, {out['kind']})")
    return 0


def cmd_config(args) -> int:
    j = getattr(args, "json", False)
    try:
        schema = Schema.load()
        if args.op in ("set", "unset", "reset", "restore"):
            with state.locked():
                state.check_expect(args.expect)
                text = config_write(schema, args)
                emit({"stamp": state.stamp()}, j, text)
            return 0
        return config_read(schema, args, j)
    except ConfigError as exc:
        return fail_exc(exc, j)


def config_read(schema: Schema, args, j: bool) -> int:
    op = args.op
    if op == "path":
        emit({"path": str(paths.user_conf())}, j, str(paths.user_conf()))
        return 0
    if op == "schema":
        data = json.loads((ROOT / "schema" / "config-schema.json").read_text(encoding="utf-8"))
        data.pop("$comment", None)
        if j:
            emit(data, True)
        else:
            for k in schema.order:
                e = schema.keys[k]
                print(f"{k:22} {e['type']:8} {gen_mod._range(e):40} defecto={e['default']!r}")
        return 0
    if op == "fonts":
        fams = state.fonts(re.compile(schema.keys["fontFamily"]["pattern"]), schema.keys["fontFamily"]["maxLength"])
        if j:
            emit({"families": fams}, True)
        else:
            for f in fams:
                print(("  " if f["system"] else "~ ") + f["family"])
            print("(~ = sólo en tu $HOME: el greeter no la verá)")
        return 0
    if op == "validate":
        target = Path(args.file) if args.file else paths.user_conf()
        vals = load_user(schema, target)
        if "background" in vals:
            check_background(schema, vals["background"])
        emit({"path": str(target), "keys": len(vals)}, j, f"válido: {target} ({len(vals)} claves)")
        return 0
    with state.locked(exclusive=False):
        user = load_user(schema)
        stamp = state.stamp()
    if op == "show":
        values = {k: {"value": user.get(k, schema.keys[k]["default"]), "default": schema.keys[k]["default"],
                      "set": k in user} for k in schema.order}
        if j:
            emit({"version": schema.version, "path": str(paths.user_conf()), "stamp": stamp, "values": values,
                  "warnings": font_warning(schema, user)}, True)
        else:
            for k, v in values.items():
                print(f"{'*' if v['set'] else ' '} {k:22} {v['value']!r}")
            for w in font_warning(schema, user):
                print(f"aviso: {w['message']}")
        return 0
    if op == "get":
        e = schema.entry(args.key)
        v = user.get(args.key, e["default"])
        emit({"key": args.key, "value": v, "set": args.key in user}, j, str(v))
        return 0
    return fail(f"operación desconocida: {op}", j, 2, code="usage")


def config_write(schema: Schema, args) -> str:
    """Escrituras de `config` (con el bloqueo tomado y --expect comprobado). Devuelve el texto para personas."""
    op = args.op
    conf = paths.user_conf()
    prev = conf.with_name(conf.name + ".prev")
    if op == "reset":
        if conf.exists() or conf.is_symlink():
            ini.write_atomic(prev, ini.read_file(conf))
            conf.unlink()
        return "configuración restablecida (copia en theme.conf.user.prev)"
    if op == "restore":
        if not prev.exists():
            raise ConfigError("no hay copia anterior (theme.conf.user.prev)", code="missing")
        save_user(schema, load_user(schema, prev))
        return "copia anterior restaurada"
    user = load_user(schema)
    new = dict(user)
    if op == "unset":
        for k in args.keys:
            schema.entry(k)
            new.pop(k, None)
    else:  # set: todo o nada; si una pareja falla, no se escribe ninguna
        errors = []
        for item in args.pairs:
            k, sep, v = item.partition("=")
            k = k.strip()
            if not sep:
                errors.append(f"«{item}»: se esperaba CLAVE=VALOR")
                continue
            try:
                e = schema.entry(k)
                if v.strip() == "":
                    new.pop(k, None)
                    continue
                new[k] = strict(e, v)
                if k == "background":
                    check_background(schema, new[k])
            except ConfigError as exc:
                errors.append(str(exc))
        if errors:
            raise ConfigError("; ".join(errors))
    if new != user:
        save_user(schema, new)
    return f"guardado en {conf}"


def cmd_wallpaper(args) -> int:
    j = getattr(args, "json", False)
    staged = paths.staged_backgrounds()
    try:
        schema = Schema.load()
        if args.op == "info":
            with state.locked(exclusive=False):
                bg = load_user(schema).get("background", "")
                out = {"background": bg}
                if bg:
                    f = paths.config_dir() / bg if bg.startswith("backgrounds/") else Path(bg)
                    info = image.inspect(f)
                    out.update({"file": str(f), "width": info.width, "height": info.height, "kind": info.kind,
                                "bytes": info.size})
            emit(out, j, json.dumps(out, ensure_ascii=False))
            return 0
        with state.locked():
            state.check_expect(args.expect)
            user = load_user(schema)
            if args.op == "set":
                dest, info = image.copy_validated(Path(args.file), staged, paths.WALLPAPER_STEM)
                # Quitar copias anteriores con otra extensión (sólo las nuestras: user.<ext>).
                for old in staged.glob(paths.WALLPAPER_STEM + ".*"):
                    if old != dest and old.is_file() and not old.is_symlink():
                        old.unlink()
                user["background"] = f"{paths.WALLPAPER_DIR}/{dest.name}"
                save_user(schema, user)
                emit({"background": user["background"], "width": info.width, "height": info.height,
                      "kind": info.kind, "bytes": info.size, "stamp": state.stamp()}, j,
                     f"wallpaper preparado: {dest} ({info.width}×{info.height} {info.kind})")
                return 0
            if args.op == "clear":
                user.pop("background", None)
                save_user(schema, user)
                for old in staged.glob(paths.WALLPAPER_STEM + ".*"):
                    if old.is_file() and not old.is_symlink():
                        old.unlink()
                emit({"stamp": state.stamp()}, j, "wallpaper quitado: se usará el fondo generado")
                return 0
    except ConfigError as exc:
        return fail_exc(exc, j)
    return fail("operación desconocida", j, 2, code="usage")


# ── Copia preparada del tema (vista previa, prueba) ──────────────────────────────────────
def stage_theme(where: str, with_user: bool, user_conf_file: str | None = None) -> Path:
    """Copia el tema a ~/.cache/sumi-sddm/<where>/sumi; con with_user, añade la config y el wallpaper."""
    base = paths.cache_dir() / where
    target = base / "sumi"
    if target.exists() or target.is_symlink():
        assert target.resolve().is_relative_to(paths.cache_dir().resolve()), target
        shutil.rmtree(target)
    base.mkdir(parents=True, exist_ok=True)
    shutil.copytree(THEME, target, symlinks=False)
    if user_conf_file:
        shutil.copyfile(user_conf_file, target / "theme.conf.user")
    elif with_user:
        schema = Schema.load()
        vals = load_user(schema)
        if vals:
            (target / "theme.conf.user").write_text(ini.render(schema, vals, HEADER), encoding="utf-8")
        bg = vals.get("background", "")
        if bg.startswith("backgrounds/"):
            src = paths.config_dir() / bg
            (target / "backgrounds").mkdir(exist_ok=True)
            dest, _ = image.copy_validated(src, target / "backgrounds", Path(bg).stem)
    return target


def render_one(qml: str, theme: Path | None, scenario: str, size: str, out: Path, backend: str,
               config: dict | None, me: str = "") -> tuple[bool, list[str]]:
    cmd = [qml, str(paths.HARNESS / "Render.qml"), "--", f"--scenario={scenario}", f"--size={size}", f"--out={out}"]
    if theme:
        cmd.append(f"--theme={theme}")
    if config:
        cmd.append("--config=" + json.dumps(config, ensure_ascii=False))
    if me:
        cmd.append(f"--me={me}")
    p = subprocess.run(cmd, env=offscreen_env(backend), capture_output=True, text=True, timeout=90)
    log = (p.stdout + p.stderr).strip().splitlines()
    noise = [l for l in log if not l.startswith(("qml: sumi-sddm: ready", "qml: render: saved"))]
    return p.returncode == 0 and out.exists() and not noise, noise


def my_display_name() -> str:
    try:
        gecos = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
        return gecos or pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        return ""


def cmd_preview(args) -> int:
    j = args.json
    if not re.fullmatch(r"[1-9][0-9]{2,4}x[1-9][0-9]{2,4}", args.size):
        return fail(f"tamaño inválido: {args.size} (AnchoxAlto)", j, 2, code="usage")
    try:
        schema = Schema.load()
        # Una vista previa a la vez (la copia preparada es compartida); la config se lee como una foto coherente.
        with state.locked_file(paths.cache_dir() / ".lock-preview", timeout=60):
            with state.locked(exclusive=False):
                target = stage_theme("preview", with_user=True)
                vals = load_user(schema)
                stamp = state.stamp()
            out = Path(args.out) if args.out else paths.cache_dir() / "preview" / f"{args.scenario}-{args.size}.png"
            out.parent.mkdir(parents=True, exist_ok=True)
            if out.exists():
                out.unlink()
            # auto: OpenGL (blur y sombras como en el greeter) y, si no hay contexto gráfico (sin GPU accesible,
            # sesión remota, banco sin pantalla), el renderizador software, que el tema también admite.
            tried = ["opengl", "software"] if args.backend == "auto" else [args.backend]
            for backend in tried:
                ok, noise = render_one(qt_tool("qml"), target, args.scenario, args.size, out, backend,
                                       raw_for_qml(schema, vals), my_display_name())
                if ok or not any(m in l for l in noise for m in GL_FAILURE):
                    break
    except ConfigError as exc:
        return fail_exc(exc, j)
    if not ok:
        return fail("no se pudo generar la vista previa: " + " | ".join(noise[-5:]), j, code="render")
    emit({"png": str(out), "scenario": args.scenario, "size": args.size, "stamp": stamp, "backend": backend}, j,
         str(out))
    return 0


def cmd_try(args) -> int:
    if not args.yes:
        print("sumi-sddm try abre el greeter real en una VENTANA de prueba (--test-mode):\n"
              "  · toma el teclado mientras esté abierta; ciérrala para recuperarlo\n"
              "  · no inicia sesión ni apaga: sin daemon, esos botones no hacen nada\n"
              "Repite con --yes para abrirla.")
        return 2
    try:
        with state.locked_file(paths.cache_dir() / ".lock-try", timeout=1):
            with state.locked(exclusive=False):
                target = stage_theme("try", with_user=True)
            return subprocess.run([GREETER, "--test-mode", "--theme", str(target)]).returncode
    except ConfigError as exc:
        if exc.code == "busy":
            return fail("ya hay una ventana de prueba abierta", code="busy")
        return fail_exc(exc, False)


def stamp_arg(v: str) -> str:
    if not re.fullmatch(r"[0-9a-f]{32}", v):
        raise argparse.ArgumentTypeError("huella inválida (32 caracteres hexadecimales)")
    return v


def cmd_install(args) -> int:
    if args.status:
        st = install_mod.status()
        emit(st, args.json, (f"instalado: {st['release']}" if st["installed"] else "no instalado")
             + (f"\n{st['launcher']} existe y no es nuestro" if st["foreign"] else ""))
        return 0
    with state.locked_file(install_mod.data_dir() / ".lock", timeout=10):
        out = install_mod.install(ROOT)
    emit(out, args.json, f"instalado {out['version']} en {out['release']}\nlanzador: {out['launcher']}"
         + (f"\nanterior conservada: {out['previous']}" if out["previous"] else ""))
    return 0


def cmd_uninstall(args) -> int:
    lock = install_mod.data_dir() / ".lock"
    with state.locked_file(lock, timeout=10):
        out = install_mod.uninstall()
    lock.unlink(missing_ok=True)
    try:
        install_mod.data_dir().rmdir()
    except OSError:
        pass
    done = "\n".join(f"borrado: {r}" for r in out["removed"]) or "no estaba instalado"
    emit(out, args.json, done + f"\n(la configuración en {out['kept']} se conserva)")
    return 0


DEV_COMMANDS = {"gen", "lint", "test", "render", "smoke", "check"}


def cmd_gen(args) -> int:
    stale = gen_mod.generate(check=args.check)
    if args.check:
        for p in stale:
            print(f"desactualizado: {p.relative_to(ROOT)}")
        print(f"gen: {'OK' if not stale else 'FALLO'}")
        return 1 if stale else 0
    for p in stale:
        print(f"escrito: {p.relative_to(ROOT)}")
    print("gen: OK")
    return 0


# ── Desarrollo ───────────────────────────────────────────────────────────────────────────
def qml_files(*dirs: Path) -> list[str]:
    return sorted(str(p) for d in dirs for p in d.rglob("*.qml"))


def cmd_lint(_args) -> int:
    qmllint = qt_tool("qmllint")
    files = [f for f in qml_files(THEME, ROOT / "tests", paths.HARNESS) if not f.endswith("/Main.qml")]
    bad = []
    for f in files:  # uno a uno: con varios a la vez qmllint ha llegado a omitir avisos
        if subprocess.run([qmllint, "--max-warnings", "0", f]).returncode != 0:
            bad.append(f)
    if subprocess.run([qmllint, "--max-warnings", "0", "--unqualified", "disable", str(THEME / "Main.qml")]).returncode:
        bad.append("Main.qml")
    print(f"lint: {'OK' if not bad else 'FALLO'} ({len(files) + 1} archivos)")
    return 1 if bad else 0


def cmd_test(args) -> int:
    failed = False
    print("── test (python)")
    p = subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", str(ROOT / "tests" / "py")],
                       capture_output=True, text=True, timeout=600, cwd=ROOT)
    tail = (p.stdout + p.stderr).strip().splitlines()
    for line in tail[-4:] if p.returncode == 0 else tail[-40:]:
        print("  " + line)
    failed |= p.returncode != 0
    runner = qt_tool("qmltestrunner")
    for backend in args.backend or list(BACKENDS):
        print(f"── test (qml, {backend})")
        p = subprocess.run([runner, "-input", str(ROOT / "tests" / "qml")], env=offscreen_env(backend),
                           capture_output=True, text=True, timeout=600)
        for line in (p.stdout + p.stderr).splitlines():
            if line.startswith(("FAIL", "Totals", "   Loc", "   Actual", "   Expected")):
                print("  " + line)
        failed |= p.returncode != 0
    print(f"test: {'FALLO' if failed else 'OK'}")
    return 1 if failed else 0


def cmd_render(args) -> int:
    qml = qt_tool("qml")
    out_root = Path(args.out).resolve()
    failures = 0
    config = json.loads(args.config) if args.config else None
    for backend in args.backend or ["opengl"]:
        for size in args.size or ["1920x1080"]:
            d = out_root / backend / size
            d.mkdir(parents=True, exist_ok=True)
            for sc in args.scenario or SCENARIOS:
                ok, noise = render_one(qml, None, sc, size, d / f"{sc}.png", backend, config)
                failures += not ok
                print(f"  {backend:8} {size:9} {sc:15} {'ok' if ok else 'FALLO'}")
                for l in noise:
                    print("      " + l)
    print(f"render: {'OK' if failures == 0 else f'{failures} fallos'} → {out_root}")
    return 0 if failures == 0 else 1


def journal_for(pid: int, since: str) -> list[str]:
    p = subprocess.run(["journalctl", "--no-pager", "-o", "cat", f"_PID={pid}", "--since", since],
                       capture_output=True, text=True)
    return p.stdout.splitlines()


def cmd_smoke(args) -> int:
    if not shutil.which(GREETER):
        print(f"smoke: {GREETER} no está instalado")
        return 1
    failed = False
    for backend in args.backend or list(BACKENDS):
        try:
            target = stage_theme("smoke", with_user=args.with_user_config, user_conf_file=args.user_conf)
        except ConfigError as exc:
            return fail(str(exc))
        since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - 1))
        proc = subprocess.Popen([GREETER, "--test-mode", "--theme", str(target)], env=offscreen_env(backend),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        time.sleep(args.seconds)
        proc.terminate()
        try:
            out, _ = proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            out, _ = proc.communicate()
        lines: list[str] = []
        for _ in range(10):
            lines = journal_for(proc.pid, since)
            if any("sumi-sddm: ready" in l for l in lines):
                break
            time.sleep(0.3)
        lines += [l for l in (out or "").splitlines() if l.strip()]
        keywords = ("TypeError", "ReferenceError", "is not defined", "Cannot assign", "failed to load",
                    "Fallback to embedded theme", "Unable to", "Cannot open")
        problems = [l for l in lines
                    if (target.as_uri() in l or any(k in l for k in keywords))
                    and not l.startswith(("Loading file://", "Loading theme configuration"))]
        ready = [l for l in lines if "sumi-sddm: ready" in l]
        ok = bool(ready) and not problems
        if ok and args.expect_custom is not None and f"custom={args.expect_custom}" not in ready[0]:
            problems.append(f"se esperaba custom={args.expect_custom}: {ready[0]}")
            ok = False
        failed |= not ok
        print(f"── smoke ({backend}) pid={proc.pid}: {'OK' if ok else 'FALLO'}")
        for l in [l for l in lines if "Loading theme configuration" in l] + ready:
            print("  " + l)
        for l in problems:
            print("  ! " + l)
        if args.verbose:
            for l in lines:
                print("    | " + l)
    print(f"smoke: {'FALLO' if failed else 'OK'}")
    return 1 if failed else 0


def cmd_check(args) -> int:
    rc = cmd_gen(argparse.Namespace(check=True))
    rc |= cmd_lint(args)
    rc |= cmd_test(argparse.Namespace(backend=None))
    base = dict(backend=None, user_conf=None, with_user_config=False, seconds=5, verbose=False)
    rc |= cmd_smoke(argparse.Namespace(**base, expect_custom=0))
    # Lectura real de QSettings frente a la nuestra: el greeter debe ver exactamente estas claves cambiadas.
    fixtures = ROOT / "tests" / "fixtures"
    rc |= cmd_smoke(argparse.Namespace(**dict(base, backend=["opengl"], user_conf=str(fixtures / "valid.conf.user")),
                                       expect_custom=4))
    rc |= cmd_smoke(argparse.Namespace(**dict(base, backend=["opengl"], user_conf=str(fixtures / "garbage.conf.user")),
                                       expect_custom=3))
    print(f"check: {'OK' if rc == 0 else 'FALLO'}")
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(prog="sumi-sddm", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def writer(x):
        x.add_argument("--json", action="store_true")
        x.add_argument("--expect", metavar="HUELLA", type=stamp_arg,
                       help="escribe sólo si la configuración sigue con esta huella (la «stamp» de config show)")

    v = sub.add_parser("version")
    v.add_argument("--json", action="store_true")
    v.set_defaults(func=cmd_version)

    c = sub.add_parser("config")
    csub = c.add_subparsers(dest="op", required=True)
    for name in ("path", "schema", "show", "fonts"):
        x = csub.add_parser(name)
        x.add_argument("--json", action="store_true")
    x = csub.add_parser("get")
    x.add_argument("key")
    x.add_argument("--json", action="store_true")
    x = csub.add_parser("set")
    x.add_argument("pairs", nargs="+", metavar="CLAVE=VALOR")
    writer(x)
    x = csub.add_parser("unset")
    x.add_argument("keys", nargs="+")
    writer(x)
    x = csub.add_parser("validate")
    x.add_argument("file", nargs="?")
    x.add_argument("--json", action="store_true")
    for name in ("reset", "restore"):
        writer(csub.add_parser(name))
    c.set_defaults(func=cmd_config)

    w = sub.add_parser("wallpaper")
    wsub = w.add_subparsers(dest="op", required=True)
    x = wsub.add_parser("set")
    x.add_argument("file")
    writer(x)
    writer(wsub.add_parser("clear"))
    x = wsub.add_parser("info")
    x.add_argument("--json", action="store_true")
    w.set_defaults(func=cmd_wallpaper)

    i = sub.add_parser("install")
    mode = i.add_mutually_exclusive_group(required=True)
    mode.add_argument("--user", action="store_true", help="copia a ~/.local/share/sumi-sddm y lanzador en ~/.local/bin")
    mode.add_argument("--status", action="store_true")
    i.add_argument("--json", action="store_true")
    i.set_defaults(func=cmd_install)
    u = sub.add_parser("uninstall")
    u.add_argument("--user", action="store_true", required=True)
    u.add_argument("--json", action="store_true")
    u.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("preview")
    p.add_argument("--out")
    p.add_argument("--scenario", default="expanded", choices=SCENARIOS)
    p.add_argument("--size", default="1920x1080")
    p.add_argument("--backend", default="auto", choices=["auto", *BACKENDS],
                   help="auto: OpenGL y, si no hay contexto gráfico, software")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_preview)

    t = sub.add_parser("try")
    t.add_argument("--yes", action="store_true")
    t.set_defaults(func=cmd_try)

    g = sub.add_parser("gen")
    g.add_argument("--check", action="store_true")
    g.set_defaults(func=cmd_gen)

    sub.add_parser("lint").set_defaults(func=cmd_lint)
    t = sub.add_parser("test")
    t.add_argument("--backend", action="append", choices=list(BACKENDS))
    t.set_defaults(func=cmd_test)
    r = sub.add_parser("render")
    r.add_argument("--out", default=str(ROOT / "tests" / "out"))
    r.add_argument("--scenario", action="append", choices=SCENARIOS)
    r.add_argument("--size", action="append", help="AnchoxAlto (repetible); 'all' = " + ",".join(SIZES))
    r.add_argument("--backend", action="append", choices=list(BACKENDS))
    r.add_argument("--config", help="JSON con claves de theme.conf")
    r.set_defaults(func=cmd_render)
    s = sub.add_parser("smoke")
    s.add_argument("--backend", action="append", choices=list(BACKENDS))
    s.add_argument("--user-conf", help="archivo a copiar como theme.conf.user en la copia de prueba")
    s.add_argument("--with-user-config", action="store_true", help="usar ~/.config/sumi-sddm")
    s.add_argument("--expect-custom", type=int, help="nº de claves distintas del defecto que debe leer el greeter")
    s.add_argument("--seconds", type=float, default=5)
    s.add_argument("-v", "--verbose", action="store_true")
    s.set_defaults(func=cmd_smoke)
    sub.add_parser("check").set_defaults(func=cmd_check)

    args = ap.parse_args()
    j = getattr(args, "json", False)
    if args.cmd in DEV_COMMANDS and state.kind() != "checkout":
        return fail(f"«{args.cmd}» sólo está disponible en el repositorio de Sumi SDDM", j, 2, code="unsupported")
    if getattr(args, "size", None) == ["all"]:
        args.size = SIZES
    try:
        return args.func(args)
    except ConfigError as exc:
        return fail_exc(exc, j)
    except OSError as exc:
        where = f"{exc.filename}: " if exc.filename else ""
        return fail(f"{where}{exc.strerror or exc}", j, code="io")


if __name__ == "__main__":
    sys.exit(main())
