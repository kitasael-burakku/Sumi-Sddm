def emit(obj, as_json: bool, text: str = "") -> None:
    """Respuesta correcta. En JSON siempre lleva `ok` y `api` (docs/CLI-JSON.md)."""
    if as_json:
        print(json.dumps({"ok": True, "api": state.API, **obj}, ensure_ascii=False, indent=1))
    elif text:
        print(text)


def fail(msg: str, as_json: bool = False, rc: int = 1, code: str = "invalid", *, en: str | None = None,
         fields: list[dict] | None = None, **extra) -> int:
    """Error. En JSON: {ok: false, api, code, error, message, fields?, …}.

    `code` es estable; `error` es texto para personas en la terminal (español); `message`, el mismo en inglés para
    interfaces (si no se da, el genérico de su código); `fields`, [{key, message}] con los errores de cada clave.
    """
    if as_json:
        doc = {"ok": False, "api": state.API, "code": code, "error": msg,
               "message": en or GENERIC_EN.get(code, GENERIC_EN["invalid"]), **extra}
        if fields:
            doc["fields"] = fields
        print(json.dumps(doc, ensure_ascii=False))
    else:
        print(f"sumi-sddm: {msg}", file=sys.stderr)
    return rc


def fail_exc(exc: ConfigError, as_json: bool) -> int:
    return fail(str(exc), as_json, code=exc.code, en=exc.english(), fields=exc.fields, **exc.extra)


def qt_tool(name: str) -> str:
    p = QT_BIN / name
    if p.exists():
        return str(p)
    found = shutil.which(name)
    if not found:
        sys.exit(f"sumi-sddm: no encuentro {name}")
    return found


def offscreen_env(backend: str) -> dict:
    env = dict(os.environ)
    env.update({"QT_QPA_PLATFORM": "offscreen", "QT_FORCE_STDERR_LOGGING": "1"})
    env.update(BACKENDS[backend])
    for k in ("QT_SCALE_FACTOR", "QT_SCREEN_SCALE_FACTORS", "QT_AUTO_SCREEN_SCALE_FACTOR", "QT_QUICK_CONTROLS_STYLE"):
        env.pop(k, None)
    return env


# ── Configuración del usuario ────────────────────────────────────────────────────────────
def load_user(schema: Schema, path: Path | None = None) -> dict:
    """Valores personalizados validados (estricto). {} si no hay archivo."""
    path = path or paths.user_conf()
    if not path.exists() and not path.is_symlink():
        return {}
    return ini.validate(schema, ini.parse(ini.read_file(path)))


def save_user(schema: Schema, values: dict) -> None:
    ini.write_atomic(paths.user_conf(), ini.render(schema, values, HEADER))


def raw_for_qml(schema: Schema, values: dict) -> dict:
    """Valores tal como los entregaría QSettings al tema (cadenas sin comillas)."""
    return ini.parse(ini.render(schema, values))


def check_background(schema: Schema, value: str) -> None:
    """Además del formato, la imagen referida debe existir y ser válida."""
    if value == "":
        return
    if value.startswith("backgrounds/"):
        f = paths.config_dir() / value
    else:
        f = Path(value)
    image.inspect(f)


def font_warning(schema: Schema, user: dict) -> list[dict]:
    """Aviso si fontFamily no está instalada fuera de $HOME (el greeter no la verá y Qt usará otra)."""
    fam = user.get("fontFamily", "")
    if not fam:
        return []
    try:
        known = {f["family"]: f["system"] for f in state.fonts(re.compile(schema.keys["fontFamily"]["pattern"]))}
    except (ConfigError, OSError, subprocess.SubprocessError):
        return []
    if known.get(fam):
        return []
    why = "only installed in your home folder" if fam in known else "not installed"
    w = {"key": "fontFamily", "message": f"“{fam}” is {why}: the login screen will use another font"}
    hint = suggest_font(fam, [f for f, system in known.items() if system])
    if hint:
        w["suggestion"] = hint
        w["message"] += f" · did you mean “{hint}”?"
    return [w]


def suggest_font(name: str, families: list[str]) -> str:
    """La familia instalada más parecida: la que empieza igual (la más corta: «Maple Mono» → «Maple Mono NF»),
    la que coincide sin mayúsculas ni espacios, o la más cercana por difflib. "" si ninguna se parece."""
    import difflib
    key = name.casefold()
    squash = lambda s: re.sub(r"[\s_-]+", "", s.casefold())
    exact = [f for f in families if squash(f) == squash(name)]
    if exact:
        return exact[0]
    prefix = sorted((f for f in families if f.casefold().startswith(key)), key=lambda f: (len(f), f))
    if prefix:
        return prefix[0]
    close = difflib.get_close_matches(key, [f.casefold() for f in families], n=1, cutoff=0.75)
    return next((f for f in families if f.casefold() == close[0]), "") if close else ""


def cmd_version(args) -> int:
    out = {"version": state.version(), "schema": Schema.load().version, "kind": state.kind()}
    emit(out, args.json, f"sumi-sddm {out['version']} (api {state.API}, esquema {out['schema']}, {out['kind']})")
    return 0


def cmd_config(args) -> int:
    j = getattr(args, "json", False)
    try:
        schema = Schema.load()
        if args.op == "edit":
            return config_edit(schema)
        if args.op in ("set", "unset", "reset", "restore"):
            with state.locked():
                state.check_expect(args.expect)
                text = config_write(schema, args)
                emit({"stamp": state.stamp()}, j, text)
            return 0
        return config_read(schema, args, j)
    except ConfigError as exc:
        return fail_exc(exc, j)


def config_read(schema: Schema, args, j: bool) -> int:
    op = args.op
    if op == "path":
        emit({"path": str(paths.user_conf())}, j, str(paths.user_conf()))
        return 0
    if op == "schema":
        data = json.loads((ROOT / "schema" / "config-schema.json").read_text(encoding="utf-8"))
        data.pop("$comment", None)
        if j:
            emit(data, True)
        else:
            for k in schema.order:
                e = schema.keys[k]
                print(f"{k:22} {e['type']:8} {gen_mod._range(e):40} defecto={e['default']!r}")
        return 0
    if op == "fonts":
        fams = state.fonts(re.compile(schema.keys["fontFamily"]["pattern"]), schema.keys["fontFamily"]["maxLength"])
        if j:
            emit({"families": fams}, True)
        else:
            for f in fams:
                print(("  " if f["system"] else "~ ") + f["family"])
            print("(~ = sólo en tu $HOME: el greeter no la verá)")
        return 0
    if op == "validate":
        target = Path(args.file) if args.file else paths.user_conf()
        vals = load_user(schema, target)
        if "background" in vals:
            check_background(schema, vals["background"])
        emit({"path": str(target), "keys": len(vals)}, j, f"válido: {target} ({len(vals)} claves)")
        return 0
    with state.locked(exclusive=False):
        user = load_user(schema)
        stamp = state.stamp()
    if op == "show":
        values = {k: {"value": user.get(k, schema.keys[k]["default"]), "default": schema.keys[k]["default"],
                      "set": k in user} for k in schema.order}
        if j:
            emit({"version": schema.version, "path": str(paths.user_conf()), "stamp": stamp, "values": values,
                  "warnings": font_warning(schema, user)}, True)
        else:
            for k, v in values.items():
                print(f"{'*' if v['set'] else ' '} {k:22} {v['value']!r}")
            for w in font_warning(schema, user):
                print(f"aviso: {w['message']}")
            print(f"(* = personalizado · editar: sumi-sddm config edit · claves documentadas: {config_doc()})")
        return 0
    if op == "get":
        e = schema.entry(args.key)
        v = user.get(args.key, e["default"])
        emit({"key": args.key, "value": v, "set": args.key in user}, j, str(v))
        return 0
    return fail(f"operación desconocida: {op}", j, 2, code="usage")


def config_write(schema: Schema, args) -> str:
    """Escrituras de `config` (con el bloqueo tomado y --expect comprobado). Devuelve el texto para personas."""
    op = args.op
    conf = paths.user_conf()
    prev = conf.with_name(conf.name + ".prev")
    if op == "reset":
        if conf.exists() or conf.is_symlink():
            ini.write_atomic(prev, ini.read_file(conf))
            conf.unlink()
        return "configuración restablecida (copia en theme.conf.user.prev)"
    if op == "restore":
        if not prev.exists():
            raise ConfigError("no hay copia anterior (theme.conf.user.prev)", code="missing",
                          en="There is no earlier copy to restore (it is made by “Reset all”)")
        save_user(schema, load_user(schema, prev))
        return "copia anterior restaurada"
    user = load_user(schema)
    new = dict(user)
    if op == "unset":
        for k in args.keys:
            schema.entry(k)
            new.pop(k, None)
    else:  # set: todo o nada; si una pareja falla, no se escribe ninguna
        errors = []
        for item in args.pairs:
            k, sep, v = item.partition("=")
            k = k.strip()
            if not sep:
                errors.append(ConfigError(f"«{item}»: se esperaba CLAVE=VALOR", en=f"“{item}”: expected KEY=VALUE"))
                continue
            try:
                e = schema.entry(k)
                if v.strip() == "":
                    new.pop(k, None)
                    continue
                new[k] = strict(e, v)
                if k == "background":
                    check_background(schema, new[k])
            except ConfigError as exc:
                if exc.key is None and k in schema.keys:   # p. ej. la imagen de `background` no vale
                    exc = ConfigError(str(exc), exc.code, key=k, en=exc.en or exc.english(), **exc.extra)
                errors.append(exc)
        if errors:
            raise ConfigError.combine(errors)
    if new != user:
        save_user(schema, new)
    return f"guardado en {conf}"


def config_doc() -> str:
    """Dónde leer qué hace cada clave: docs/CONFIG.md (está en el repositorio y en la copia de usuario)."""
    doc = ROOT / "docs" / "CONFIG.md"
    return str(doc) if doc.is_file() else "sumi-sddm config schema"


# ── config edit ─────────────────────────────────────────────────────────────────────────
EDIT_NOTE = (
    "Sumi SDDM — edición de theme.conf.user (sumi-sddm config edit).\n"
    "Las líneas que empiezan por «;» son comentarios. Para cambiar una clave, quita el «;» de su línea y\n"
    "edita el valor; para volver al valor por defecto, comenta otra vez la línea o bórrala.\n"
    "Al guardar y cerrar se valida todo: si hay un error no se escribe nada y puedes volver a editar.\n"
    "Cerrar sin cambios, o vaciar el archivo, cancela. Para volver a todos los defectos: sumi-sddm config reset.")
EDIT_ERROR = "; ERROR: "


def edit_buffer(schema: Schema, user: dict) -> str:
    """Texto que se abre en el editor: las claves personalizadas activas y el resto comentadas con su defecto."""
    out = [";" + (" " + l if l else "") for l in EDIT_NOTE.splitlines()]
    out += ["", f"[{schema.section}]"]
    titles = {g["id"]: g.get("doc") or g["label"] for g in schema.groups}
    group = None
    for k in schema.order:
        e = schema.keys[k]
        if e["group"] != group:
            group = e["group"]
            title = f"; ── {titles[group]} "
            out += ["", title + "─" * max(4, 72 - len(title))]
        out.append("")
        out += ["; " + l for l in textwrap.wrap(e["doc"], 100)]
        out.append(f"; {gen_mod._range(e)} · defecto: {to_ini(e, e['default'])}")
        out.append(f"{k}={to_ini(e, user[k])}" if k in user else f";{k}={to_ini(e, e['default'])}")
    return "\n".join(out) + "\n"


def strip_edit_errors(text: str) -> str:
    """Quita el bloque «; ERROR: …» que se antepone al volver a abrir el editor (y su línea en blanco)."""
    lines = text.split("\n")
    i = 0
    while i < len(lines) and lines[i].startswith(EDIT_ERROR):
        i += 1
    if i and i < len(lines) and lines[i] == "":
        i += 1
    return "\n".join(lines[i:])


def with_edit_errors(body: str, message: str) -> str:
    """Antepone los errores como comentarios. Los números de línea se corrigen para el archivo que se reabre."""
    errors = [m for m in message.split("; ") if m]
    shift = len(errors) + 1
    fixed = [re.sub(r"línea (\d+)", lambda m: f"línea {int(m.group(1)) + shift}", m) for m in errors]
    return "\n".join(EDIT_ERROR + m for m in fixed) + "\n\n" + body


def find_editor() -> list[str]:
    """$VISUAL, $EDITOR o el primero de nano, vim, vi. Admite argumentos («code --wait»)."""
    for var in ("VISUAL", "EDITOR"):
        value = os.environ.get(var, "").strip()
        if not value:
            continue
        try:
            cmd = shlex.split(value)
        except ValueError:
            raise ConfigError(f"no entiendo ${var}: {value}") from None
        if cmd and shutil.which(cmd[0]):
            return cmd
        raise ConfigError(f"no encuentro el editor de ${var}: {cmd[0] if cmd else value}", code="missing")
    for name in ("nano", "vim", "vi"):
        if shutil.which(name):
            return [name]
    raise ConfigError("no hay ningún editor: define $EDITOR (por ejemplo, EDITOR=nano)", code="missing")


def check_edited(schema: Schema, body: str) -> dict:
    vals = ini.validate(schema, ini.parse(body))
    if "background" in vals:
        check_background(schema, vals["background"])
    return vals


def config_edit(schema: Schema) -> int:
    """Edita theme.conf.user en $EDITOR. El bloqueo no se mantiene mientras el editor está abierto (Settings
    seguiría pudiendo escribir); en su lugar, la huella del principio se comprueba al guardar, como --expect."""
    editor = find_editor()
    conf = paths.user_conf()
    with state.locked(exclusive=False):
        start = state.stamp()
        try:
            user = load_user(schema)
            first, errors = edit_buffer(schema, user), ""
        except ConfigError as exc:   # archivo roto: se abre tal cual para poder arreglarlo
            user, first, errors = None, ini.read_file(conf), str(exc)
    base = paths.cache_dir() / "edit"
    base.mkdir(parents=True, exist_ok=True, mode=0o700)
    work = Path(tempfile.mkdtemp(dir=base, prefix="edit-"))
    buf = work / "theme.conf.user.ini"
    keep = f"tu edición sigue en {buf}"
    text = with_edit_errors(first, errors) if errors else first
    while True:
        buf.write_text(text, encoding="utf-8")
        rc = subprocess.run([*editor, str(buf)]).returncode
        if rc != 0:
            shutil.rmtree(work, ignore_errors=True)
            return fail(f"el editor terminó con el código {rc}; no se cambió nada")
        try:
            body = strip_edit_errors(buf.read_text(encoding="utf-8"))
        except UnicodeDecodeError:
            return fail(f"el archivo editado no es UTF-8; no se cambió nada ({keep})")
        if body == first or not body.strip():
            shutil.rmtree(work, ignore_errors=True)
            print("sin cambios" if body.strip() else "archivo vacío: edición cancelada")
            return 0
        try:
            new = check_edited(schema, body)
            break
        except ConfigError as exc:
            if not sys.stdin.isatty():
                return fail(f"{exc}. No se cambió nada; {keep}")
            print(f"sumi-sddm: {exc}", file=sys.stderr)
            try:
                again = input("¿Volver a editar? [S/n] ").strip().lower()
            except EOFError:
                again = "n"
            if again in ("n", "no"):
                return fail(f"no se cambió nada; {keep}")
            text = with_edit_errors(body, str(exc))
    try:
        with state.locked():
            state.check_expect(start)
            if new != user:
                save_user(schema, new)
    except ConfigError as exc:
        if exc.code == "conflict":
            return fail(f"la configuración cambió mientras editabas (otra ventana o la terminal); no se guardó. "
                        f"{keep}", code="conflict")
        raise
    shutil.rmtree(work, ignore_errors=True)
    print(f"guardado en {conf}" if new != user else "sin cambios")
    return 0


def cmd_wallpaper(args) -> int:
    j = getattr(args, "json", False)
    staged = paths.staged_backgrounds()
    try:
        schema = Schema.load()
        if args.op == "info":
            with state.locked(exclusive=False):
                bg = load_user(schema).get("background", "")
                out = {"background": bg}
                if bg:
                    f = paths.config_dir() / bg if bg.startswith("backgrounds/") else Path(bg)
                    info = image.inspect(f)
                    out.update({"file": str(f), "width": info.width, "height": info.height, "kind": info.kind,
                                "bytes": info.size})
            emit(out, j, json.dumps(out, ensure_ascii=False))
            return 0
        with state.locked():
            state.check_expect(args.expect)
            user = load_user(schema)
            if args.op == "set":
                dest, info = image.copy_validated(Path(args.file), staged, paths.WALLPAPER_STEM)
                # Quitar copias anteriores con otra extensión (sólo las nuestras: user.<ext>).
                for old in staged.glob(paths.WALLPAPER_STEM + ".*"):
                    if old != dest and old.is_file() and not old.is_symlink():
                        old.unlink()
                user["background"] = f"{paths.WALLPAPER_DIR}/{dest.name}"
                save_user(schema, user)
                emit({"background": user["background"], "width": info.width, "height": info.height,
                      "kind": info.kind, "bytes": info.size, "stamp": state.stamp()}, j,
                     f"wallpaper preparado: {dest} ({info.width}×{info.height} {info.kind})")
                return 0
            if args.op == "clear":
                user.pop("background", None)
                save_user(schema, user)
                for old in staged.glob(paths.WALLPAPER_STEM + ".*"):
                    if old.is_file() and not old.is_symlink():
                        old.unlink()
                emit({"stamp": state.stamp()}, j, "wallpaper quitado: se usará el fondo generado")
                return 0
    except ConfigError as exc:
        return fail_exc(exc, j)
    return fail("operación desconocida", j, 2, code="usage")


# ── Copia preparada del tema (vista previa, prueba) ──────────────────────────────────────
def stage_theme(where: str, with_user: bool, user_conf_file: str | None = None) -> Path:
    """Copia el tema a ~/.cache/sumi-sddm/<where>/sumi; con with_user, añade la config y el wallpaper."""
    base = paths.cache_dir() / where
    target = base / "sumi"
    if target.exists() or target.is_symlink():
        assert target.resolve().is_relative_to(paths.cache_dir().resolve()), target
        shutil.rmtree(target)
    base.mkdir(parents=True, exist_ok=True)
    # Sin la configuración aplicada: en el paquete, theme/sumi apunta al tema instalado, donde el helper deja
    # theme.conf.user y backgrounds/. La vista previa enseña sólo lo preparado por el usuario.
    shutil.copytree(THEME, target, symlinks=False, ignore=shutil.ignore_patterns("theme.conf.user", "backgrounds"))
    if user_conf_file:
        shutil.copyfile(user_conf_file, target / "theme.conf.user")
    elif with_user:
        schema = Schema.load()
        vals = load_user(schema)
        if vals:
            (target / "theme.conf.user").write_text(ini.render(schema, vals, HEADER), encoding="utf-8")
        bg = vals.get("background", "")
        if bg.startswith("backgrounds/"):
            src = paths.config_dir() / bg
            (target / "backgrounds").mkdir(exist_ok=True)
            dest, _ = image.copy_validated(src, target / "backgrounds", Path(bg).stem)
    return target


def render_one(qml: str, theme: Path | None, scenario: str, size: str, out: Path, backend: str,
               config: dict | None, me: str = "", meicon: str = "") -> tuple[bool, list[str]]:
    cmd = [qml, str(paths.HARNESS / "Render.qml"), "--", f"--scenario={scenario}", f"--size={size}", f"--out={out}"]
    if theme:
        cmd.append(f"--theme={theme}")
    if config:
        cmd.append("--config=" + json.dumps(config, ensure_ascii=False))
    if me:
        cmd.append(f"--me={me}")
    if meicon:
        cmd.append(f"--meicon={meicon}")
    p = subprocess.run(cmd, env=offscreen_env(backend), capture_output=True, text=True, timeout=90)
    log = (p.stdout + p.stderr).strip().splitlines()
    noise = [l for l in log if not l.startswith(("qml: sumi-sddm: ready", "qml: render: saved"))]
    return p.returncode == 0 and out.exists() and not noise, noise


