def crop_avatar(src_fd: int, out: Path, size: int) -> None:
    """PNG cuadrado SIZE×SIZE (centrado y recortado) con Qt offscreen; la entrada es una copia privada."""
    out.parent.mkdir(parents=True, exist_ok=True)
    work = out.with_name(".src-" + out.name)
    with os.fdopen(os.dup(src_fd), "rb") as fin, open(work, "wb") as fout:
        fin.seek(0)
        shutil.copyfileobj(fin, fout)
    try:
        if out.exists():
            out.unlink()
        p = subprocess.run([qt_tool("qml"), str(paths.HARNESS / "AvatarCrop.qml"), "--", f"--src={work}",
                            f"--out={out}", f"--size={size}"], env=offscreen_env("software"),
                           capture_output=True, text=True, timeout=60)
        if p.returncode != 0 or not out.is_file():
            raise ConfigError("no se pudo recortar la imagen: " + (p.stdout + p.stderr).strip()[-300:], code="io",
                              en="The picture could not be cropped: " + (p.stdout + p.stderr).strip()[-300:])
    finally:
        work.unlink(missing_ok=True)


