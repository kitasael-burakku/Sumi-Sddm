#: Errores del helper en inglés, por código (el helper corre como root y responde en español; no se toca).
HELPER_EN = {
    "probe": "The theme failed its test with these settings; nothing changed",
    "missing": "Something the login screen change needs is missing (is the sumi-sddm package installed?)",
    "busy": "Another login screen change is running; try again",
    "invalid": "The system helper rejected these settings; nothing changed",
    "io": "The login screen could not be changed; check it with “sumi-sddm system status”",
    "conflict": "The login screen configuration changed meanwhile; nothing was changed",
    "unsupported": "This change is not supported on this system",
}
HELPER = "/usr/lib/sumi-sddm/sumi-sddm-helper"
PKEXEC = "/usr/bin/pkexec"


def helper_paths() -> tuple[str, str]:
    """El helper instalado y pkexec. Las pruebas del repositorio pueden sustituirlos (nunca la copia instalada)."""
    if state.kind() == "checkout":
        return (os.environ.get("SUMI_SDDM_HELPER") or HELPER, os.environ.get("SUMI_SDDM_PKEXEC") or PKEXEC)
    return HELPER, PKEXEC


def system_package(schema: Schema) -> tuple[bytes, dict[str, str], str]:
    """Lo que se envía al helper (formato 1), los hashes que deberían quedar en el tema y la huella de lo enviado."""
    with state.locked(exclusive=False):
        vals = load_user(schema)
        stamp = state.stamp()
        img, kind = b"", None
        bg = vals.get("background", "")
        if bg.startswith(paths.WALLPAPER_DIR + "/"):
            fd = image.open_regular(paths.config_dir() / bg)
            try:
                info = image.inspect_fd(fd)
                with os.fdopen(os.dup(fd), "rb") as f:
                    f.seek(0)    # el descriptor duplicado comparte la posición que dejó inspect_fd
                    img, kind = f.read(image.MAX_BYTES + 1), info.kind
            finally:
                os.close(fd)
    conf = ini.render(schema, vals, ini.APPLIED_HEADER).encode() if vals else b""
    header = {"format": 1, "conf": len(conf), "image": {"kind": kind, "bytes": len(img)} if kind else None}
    expected = {}
    if vals:
        expected["theme.conf.user"] = hashlib.sha256(conf).hexdigest()
    if kind:
        expected[f"backgrounds/user.{kind}"] = hashlib.sha256(img).hexdigest()
    return (json.dumps(header).encode() + b"\n" + conf + img), expected, stamp


def run_helper(argv: list[str], data: bytes | None = None, timeout: int = 600) -> tuple[dict | None, int, str]:
    p = subprocess.run(argv, input=data if data is not None else b"", capture_output=True, timeout=timeout)
    text = p.stdout.decode("utf-8", "replace").strip()
    doc = None
    for line in reversed(text.splitlines()):
        try:
            doc = json.loads(line)
            break
        except ValueError:
            continue
    return doc, p.returncode, p.stderr.decode("utf-8", "replace").strip()


def cmd_system_log(args) -> int:
    """Lo que pasó en la pantalla de inicio de un arranque (journal, sin root)."""
    from sumiconf import greeterlog
    j = args.json
    schema = Schema.load()
    conf = Path("/usr/share/sddm/themes/sumi/theme.conf.user")
    try:
        raw = ini.parse(conf.read_text(encoding="utf-8")) if conf.is_file() else {}
        expect = probe.expected_custom(schema, raw)
    except (OSError, ConfigError):
        expect = None
    entries = greeterlog.read_journal(args.boot)
    if not entries:
        return fail(f"el journal no tiene registros del greeter en el arranque {args.boot}", j, code="missing",
                    en="No login screen has been recorded in this boot's journal")
    s = greeterlog.summarize(entries, expect)
    s["boot"] = args.boot
    lines = []
    for g in s["greeters"]:
        when = time.strftime("%H:%M:%S", time.localtime(g["time"]))
        if not g["sumi"]:
            lines.append(f"{when} greeter con otro tema: {g['theme'] or '?'}")
            continue
        lines.append(f"{when} Sumi: {'OK' if g['ok'] else 'PROBLEMAS'} · {g['ready'] or 'sin ready'}")
        lines += ["   ! " + pr for pr in g["problems"]]
    lines.append(f"inicios de sesión: {s['logins']['succeeded']} correctos, {s['logins']['failed']} fallidos"
                 + (f" · sesión: {', '.join(s['sessions'])}" if s["sessions"] else ""))
    asked = {k: v for k, v in s["requests"].items() if k not in ("Connect", "Login")}
    if asked:
        lines.append("otras peticiones del greeter: " + ", ".join(f"{k}×{v}" for k, v in sorted(asked.items())))
    emit(s, j, "\n".join(lines))
    return 0 if s["sumiOk"] or not any(g["sumi"] for g in s["greeters"]) else 1


def cmd_system(args) -> int:
    j = args.json
    if args.op == "log":
        return cmd_system_log(args)
    helper, pkexec = helper_paths()
    if not os.path.exists(helper):
        return fail("Sumi SDDM no está instalado en el sistema (paquete sumi-sddm; ver packaging/arch)", j,
                    code="missing", en="Sumi SDDM is not installed system-wide (sumi-sddm package)")
    try:
        schema = Schema.load()
        if args.op == "status":
            doc, rc, err = run_helper([helper, "status", "--json"], timeout=60)
            if not doc or doc.get("ok") is not True:
                return fail((doc or {}).get("error") or err or "el helper no respondió", j, code="io",
                            en="The system helper did not answer")
            _, expected, stamp = system_package(schema)
            doc.pop("ok", None), doc.pop("api", None)
            doc["inSync"] = doc.get("installed") is True and doc.get("applied") == expected
            doc["stamp"] = stamp
            emit(doc, j, (f"instalado {doc.get('version')} · " if doc.get("installed") else "no instalado · ")
                 + f"tema activo: {doc.get('activeTheme') or '(por defecto)'}"
                 + (" · tu configuración está aplicada" if doc["inSync"] else
                    " · tu configuración NO está aplicada" if doc.get("installed") else ""))
            return 0
        data = None
        argv = [pkexec, helper, args.op]
        if args.op == "deactivate" and args.theme:
            argv.append(args.theme)
        sent_stamp = None
        if args.op == "apply":
            data, _, sent_stamp = system_package(schema)
    except ConfigError as exc:
        return fail_exc(exc, j)
    doc, rc, err = run_helper(argv, data)
    if doc is None:
        if rc in (126, 127):
            return fail("autenticación cancelada o denegada; no se ha cambiado nada", j, code="denied",
                        en="Authentication cancelled or denied; nothing changed")
        return fail(err or f"el helper terminó con código {rc} sin respuesta", j, code="io",
                    en=f"The system helper ended (code {rc}) without an answer; nothing was confirmed")
    if doc.get("ok") is not True:
        extra = {k: v for k, v in doc.items() if k not in ("ok", "api", "code", "error")}
        code = str(doc.get("code", "io"))
        # El helper (root) responde en español; aquí, el inglés por código. Los detalles (problems…) van aparte.
        return fail(str(doc.get("error", "error del helper")), j, code=code,
                    en=HELPER_EN.get(code, "The login screen could not be changed; check it with “sumi-sddm system status”"), **extra)
    doc.pop("ok", None), doc.pop("api", None)
    if sent_stamp:
        doc["stamp"] = sent_stamp
    human = {"apply": "configuración aplicada al tema instalado" if doc.get("changed") else "ya estaba aplicada",
             "reset": "configuración quitada del tema instalado", "rollback": "vuelta al estado anterior",
             "activate": "Sumi será la pantalla de inicio la PRÓXIMA vez que aparezca",
             "deactivate": f"tema activo: {doc.get('activeTheme')}", "probe": "el tema instalado supera la prueba"}
    emit(doc, j, human.get(args.op, "hecho"))
    return 0


